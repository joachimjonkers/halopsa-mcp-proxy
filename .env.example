# Copy to .env for local testing (Claude Code registration passes these via -e instead).
# All values come from your HaloPSA administrator — do not commit real values.

# Your HaloPSA MCP endpoint (Config > AI > "Enable the MCP Endpoint").
HALO_URL=https://your-halopsa-instance/api/mcp

# --- Auth: use ONE of the two methods below ---

# Method 1 (recommended): OAuth2 client credentials.
HALO_CLIENT_ID=your-client-id
HALO_CLIENT_SECRET=your-client-secret
# Optional overrides:
# HALO_AUTH_URL=https://your-halopsa-instance/auth/token   # defaults to <HALO_URL origin>/auth/token
# HALO_SCOPE=all

# Method 2 (fallback): a static API key sent as X-Halo-Api-Key.
# HALO_API_KEY=your-halo-api-key

# HALO_TIMEOUT=60000
